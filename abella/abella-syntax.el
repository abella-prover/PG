;;; Commentary:

;; Syntax table entries and font-lock keywords for Abella.  The
;; keyword groups below mirror the tables generated by Abella's
;; `bin/abella_keywords.exe' from the reserved words in `src/lexer.mll'.

;;; Code:

(defconst abella-top-builtin-keywords
  '("Close" "Import" "Query" "Quit" "Set" "Show" "Specification")
  "Abella top-level built-in commands.")

(defconst abella-top-command-keywords
  '("Axiom" "CoDefine" "Define" "End" "Kind" "Module" "Split"
    "Suspend" "Theorem" "Type" "as" "by")
  "Abella top-level commands.")

(defconst abella-proof-command-keywords
  '("abbrev" "all" "apply" "assert" "backchain" "case" "clear"
    "coinduction" "compute" "cut" "fchain" "from" "induction"
    "inst" "intros" "keep" "left" "monotone" "on" "permute"
    "rename" "right" "search" "split" "split*" "to" "unabbrev"
    "unfold" "with" "witness")
  "Abella proof commands.")

(defconst abella-proof-spec-keywords
  '("abort" "skip" "undo")
  "Abella proof-script commands that are usually avoided.")

(defconst abella-term-keywords
  '("exists" "false" "forall" "nabla" "true")
  "Abella term-level keywords.")

(defconst abella-signature-keywords
  '("kind" "type")
  "Abella signature keywords.")

(defconst abella-lprolog-keywords
  '("accum_sig" "accumulate" "end" "module" "sig")
  "Lambda Prolog keywords used in Abella specification files.")

(defconst abella-operator-keywords
  '("=>" "|-" "<=" "->" ":=" ":-" "::" "/\\" "\\/" "&"
    "[" "]" "{" "}" "=" ":" ";" "," "." "\\")
  "Abella operators and structural punctuation.")

(defun abella--keyword-regexp (keywords)
  "Return a regexp matching any of KEYWORDS as one Abella identifier."
  (concat "\\_<\\(" (regexp-opt keywords) "\\)"
          "\\(?:\\_>\\|[^[:alnum:]_'-]\\|$\\)"))

(defconst abella-font-lock-keywords
  (list
   (cons (regexp-opt abella-operator-keywords) 'font-lock-builtin-face)
   (cons (abella--keyword-regexp abella-top-builtin-keywords)
         '(1 font-lock-builtin-face))
   (cons (abella--keyword-regexp abella-top-command-keywords)
         '(1 font-lock-keyword-face))
   (cons (abella--keyword-regexp abella-proof-command-keywords)
         '(1 font-lock-function-name-face))
   (cons (abella--keyword-regexp abella-proof-spec-keywords)
         '(1 font-lock-warning-face))
   (cons (abella--keyword-regexp abella-term-keywords)
         '(1 font-lock-keyword-face))
   (cons (abella--keyword-regexp abella-signature-keywords)
         '(1 font-lock-keyword-face))
   (cons (abella--keyword-regexp abella-lprolog-keywords)
         '(1 font-lock-keyword-face)))
  "Font-lock keywords for Abella scripts.")

(defconst abella-goals-font-lock-keywords
  '(("\\<Subgoal\\>" . font-lock-keyword-face))
  "Font-lock keywords for Abella goals buffers.")

(defconst abella-response-font-lock-keywords
  '(("\\<Proof completed\\>" . font-lock-function-name-face)
    ("\\<Proof NOT Completed\\.\\>" . font-lock-warning-face))
  "Font-lock keywords for Abella response buffers.")

(defconst abella-syntax-table-entries
  '(?_ "w"
    ?' "w"
    ?% "< b"
    ?\n "> b"
    ?/ "w 14n"
    ?* ". 23n"
    ?. "."
    ?+ "."
    ?= "."
    ?- "."
    ?> "."
    ?< "."
    ?# "."
    ?\\ "."
    ?& "."
    ?| "."
    ?: "."
    ?\; "."
    ?, "."
    ?@ "."
    ?^ "."
    ?~ "."
    ?! "."
    ?$ "."
    ?\" "\""
    ?\( "()"
    ?\) ")("
    ?\[ "(]"
    ?\] ")["
    ?\{ "(}"
    ?\} "){")
  "Syntax table entries for Abella scripts and output.")

(provide 'abella-syntax)

